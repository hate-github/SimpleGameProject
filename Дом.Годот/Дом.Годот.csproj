<Project Sdk="Godot.NET.Sdk/4.4.1">

  <!-- Сцены, узлы, ввод и интерфейс. Зависит от ядра и от слоя экрана —
       и ни от чего больше; консоль о нём не знает вовсе.

       Собирается без установленного редактора: `Godot.NET.Sdk` приходит
       с NuGet, и `dotnet build` проверяет весь код узлов. Запустить игру
       при этом нельзя — для этого нужен сам Godot 4.4. Разделение полезное:
       ошибку в C# видно сразу, а не «когда дойдут руки открыть редактор».

       `EnableDynamicLoading` нужен движку, чтобы перезагружать сборку
       без перезапуска редактора. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Дом.Годот</RootNamespace>
    <AssemblyName>Дом.Годот</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Дом.Ядро\Дом.Ядро.csproj" />
    <ProjectReference Include="..\Дом.Экран\Дом.Экран.csproj" />
  </ItemGroup>

</Project>
