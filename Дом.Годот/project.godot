; Проект Godot 4 для «Опять здесь».
;
; Держит только то, что принадлежит движку: окно, главную сцену и имя
; сборки. Баланс, жильцы, события и реплики остаются в `data/*.json`
; и читаются ядром напрямую — в `.tres` их не переводить, это убьёт
; двустороннюю проверку ручек (навык godot-boundary).
;
; Порядок разделов движок переписывает под себя при каждом запуске —
; спорить с ним не надо. А вот этот заголовок он сносит и подставляет
; свой; возвращать руками.

config_version=5

[application]

config/name="Опять здесь"
config/description="Пятнадцать соседей, метель и тридцать дней."
run/main_scene="res://Дом.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Дом.Годот"

[rendering]

renderer/rendering_method="mobile"
