<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ядро симуляции. Ни одной ссылки на Godot: сутки должны считаться
       из консоли, без сцены и без рендера (навык godot-boundary).
       Зависимостей нет вовсе — как и у прототипа на Python. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Дом.Ядро</RootNamespace>
    <AssemblyName>Дом.Ядро</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
